<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.keepassxc.agent-middleware</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/keepassxc-agent</string>
        <string>run</string>
        <string>--listen</string>
        <string>/Users/YOUR_USER/.keepassxc-agent/agent.sock</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/keepassxc-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/keepassxc-agent.log</string>
</dict>
</plist>
